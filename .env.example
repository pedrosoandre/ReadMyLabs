# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o .env no git

ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI
RECAPTCHA_SECRET=SUA_CHAVE_RECAPTCHA_SECRETA_AQUI

# Voyage AI — embeddings do RAG de exames (a Anthropic NÃO tem API de embeddings).
# Sem esta chave, o RAG fica desligado e o app funciona normalmente.
VOYAGE_API_KEY=pa-SUA_CHAVE_VOYAGE_AQUI
VOYAGE_MODELO_EMBED=voyage-3-large
# RAG_ATIVO=off   # descomente para desligar o RAG (dev/manutenção)

# Limite de análises por IP/dia (padrão 3 se ausente). Produção: 1.
# Anônimo usa limite por IP; logado usa cota do plano (auth/lib/quota.php).
LIMITE_DIARIO=1
# Token secreto para TESTAR sem paredes: abra o site com ?dev=ESTE_TOKEN
# → pula o paywall (front), limite de IP e cota de conta. NUNCA divulgar.
DEV_BYPASS_TOKEN=troque-por-um-token-secreto-aqui

# Analytics (Google Analytics 4 + opcionalmente Google Ads).
# Sem GA_MEASUREMENT_ID, nenhum script de tracking é renderizado (falha-para-desligado).
# Com GA configurado, banner de consentimento LGPD aparece automaticamente.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GADS_CONVERSION_ID=AW-XXXXXXXXX

# E-mail transacional (verificação, recuperação de senha).
# Sem provider/chave: cadastro vira "verificado direto" e recuperação fica
# escondida (falha-para-desligado). Provider suportado nesta fase: 'resend'|'sendgrid'.
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@readmylabs.com.br
EMAIL_FROM_NOME=ReadMyLabs
RESEND_API_KEY=re_SUA_CHAVE_RESEND_AQUI
# SENDGRID_API_KEY=SG.SUA_CHAVE_SENDGRID_AQUI

# Banco de dados (MySQL / MariaDB) — Hostinger usa prefixo u854646013_
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u854646013_readmylabs
DB_USER=u854646013_readmylabs
DB_PASS=SUA_SENHA_DO_BANCO

# SSH / Deploy — Hostinger (valores reais ficam no .env, nunca neste arquivo)
SSH_HOST=77.37.127.55
SSH_PORT=65002
SSH_USER=u854646013
SSH_PASS=SUA_SENHA_SSH
SSH_HOSTKEY=SHA256:5znhiRHvKXvXVOmrqV7woZ1aJRv89YAfyGRat/hGsqI
SSH_DEST=domains/readmylabs.com.br/public_html
