# Voyage AI — embeddings do RAG de exames (a Anthropic NÃO tem API de embeddings).
# Sem esta chave, o RAG fica desligado e o app funciona normalmente.
VOYAGE_API_KEY=pa-SUA_CHAVE_VOYAGE_AQUI
VOYAGE_MODELO_EMBED=voyage-3-large
# RAG_ATIVO=off   # descomente para desligar o RAG (dev/manutenção)

# Limite de análises por IP/dia (padrão 3 se ausente). Produção: 1.
LIMITE_DIARIO=1
# Token secreto para TESTAR sem paredes: abra o site com ?dev=ESTE_TOKEN
# → pula o paywall (front) e o limite de IP (servidor). NUNCA divulgar.
